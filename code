
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>
#include "BluetoothSerial.h"
#include <Fonts/FreeSansBold24pt7b.h>

// TFT WIRING
#define TFT_CS    5
#define TFT_RST   15
#define TFT_DC    32
#define TFT_MOSI  23
#define TFT_SCLK  18
#define TFT_LED   25

Adafruit_ST7735 tft = Adafruit_ST7735(
  TFT_CS, TFT_DC, TFT_MOSI, TFT_SCLK, TFT_RST
);

BluetoothSerial SerialBT;

const char* deviceName = "Gear Indicator";

String currentGear = "WAIT";
String inputData = "";

bool hasReceivedGear = false;
bool lastClientState = false;

unsigned long lastDataTime = 0;
unsigned long lastAnimationTime = 0;

const unsigned long DATA_TIMEOUT = 2000;
const unsigned long ANIMATION_INTERVAL = 100;

int animationFrame = 0;
int carX = -65;

#define BG_COLOR 0x0000

void drawStatus() {
  tft.fillRect(0, 138, 128, 22, BG_COLOR);

  tft.setFont(NULL);
  tft.setTextSize(1);
  tft.setTextColor(ST77XX_CYAN);

  String status = SerialBT.hasClient()
                  ? "Bluetooth Connected"
                  : "Bluetooth Waiting";

  int16_t x1, y1;
  uint16_t w, h;

  tft.getTextBounds(status, 0, 0, &x1, &y1, &w, &h);

  tft.setCursor((128 - w) / 2 - x1, 145);
  tft.print(status);
}

void drawWaitingTitle() {
  tft.setFont(NULL);
  tft.setTextSize(2);
  tft.setTextColor(ST77XX_WHITE);

  tft.setCursor(16, 12);
  tft.print("WAITING");
}

void drawCar(int x) {
  int y = 57;

  tft.fillRect(x + 5, y + 3, 3, 10, ST77XX_RED);
  tft.fillRect(x + 1, y + 2, 12, 3, ST77XX_RED);

  tft.fillRoundRect(
    x, y + 16, 62, 15, 5, ST77XX_RED
  );

  tft.fillTriangle(
    x + 43, y + 16,
    x + 62, y + 19,
    x + 57, y + 29,
    ST77XX_RED
  );

  tft.fillRoundRect(
    x + 15, y + 5, 30, 17, 8, ST77XX_RED
  );

  tft.fillTriangle(
    x + 36, y + 7,
    x + 47, y + 18,
    x + 36, y + 18,
    ST77XX_CYAN
  );

  tft.fillTriangle(
    x + 18, y + 8,
    x + 31, y + 8,
    x + 29, y + 18,
    ST77XX_CYAN
  );

  tft.fillRoundRect(
    x + 55, y + 20, 6, 4, 2, ST77XX_YELLOW
  );

  tft.fillRect(x, y + 21, 3, 5, ST77XX_WHITE);

  tft.fillCircle(x + 15, y + 30, 7, ST77XX_WHITE);
  tft.fillCircle(x + 48, y + 30, 7, ST77XX_WHITE);

  tft.fillCircle(x + 15, y + 30, 4, ST77XX_BLACK);
  tft.fillCircle(x + 48, y + 30, 4, ST77XX_BLACK);

  tft.fillCircle(x + 15, y + 30, 2, ST77XX_CYAN);
  tft.fillCircle(x + 48, y + 30, 2, ST77XX_CYAN);
}

void drawWaitingScreen() {
  tft.fillScreen(BG_COLOR);

  animationFrame = 0;
  carX = -65;

  drawWaitingTitle();
  drawStatus();
}

void updateWaitingAnimation() {
  unsigned long now = millis();

  if (now - lastAnimationTime < ANIMATION_INTERVAL) {
    return;
  }

  lastAnimationTime = now;

  tft.fillRect(0, 34, 128, 15, BG_COLOR);

  int dots = animationFrame % 4;

  for (int i = 0; i < dots; i++) {
    tft.fillCircle(
      44 + (i * 9), 40, 2, ST77XX_WHITE
    );
  }

  tft.fillRect(0, 52, 128, 47, BG_COLOR);

  tft.drawFastHLine(0, 96, 128, ST77XX_WHITE);

  for (int i = 0; i < 4; i++) {
    int roadX = (i * 40 - animationFrame * 5) % 128;

    if (roadX < 0) {
      roadX += 128;
    }

    tft.drawFastHLine(
      roadX, 99, 15, ST77XX_CYAN
    );
  }

  drawCar(carX);

  carX += 5;

  if (carX > 128) {
    carX = -65;
  }

  animationFrame++;
}

void drawGear(String gear) {
  tft.fillScreen(BG_COLOR);

  tft.setFont(&FreeSansBold24pt7b);
  tft.setTextSize(3);
  tft.setTextColor(ST77XX_WHITE);

  int16_t x1, y1;
  uint16_t w, h;

  tft.getTextBounds(gear, 0, 0, &x1, &y1, &w, &h);

  int x = (128 - w) / 2 - x1;
  int y = (132 - h) / 2 - y1;

  tft.setCursor(x, y);
  tft.print(gear);

  drawStatus();
}

void processGear(String data) {
  data.trim();
  data.toUpperCase();

  if (!data.startsWith("G:")) {
    return;
  }

  String value = data.substring(2);
  String newGear;

  if (value == "R" || value == "-1") {
    newGear = "R";
  }
  else if (value == "N" || value == "0") {
    newGear = "N";
  }
  else {
    int gear = value.toInt();

    if (gear >= 1 && gear <= 9) {
      newGear = String(gear);
    }
    else {
      return;
    }
  }

  lastDataTime = millis();

  if (!hasReceivedGear || newGear != currentGear) {
    currentGear = newGear;
    hasReceivedGear = true;

    drawGear(currentGear);
  }
}

void setup() {
  Serial.begin(115200);

  dacWrite(TFT_LED, 255);

  tft.initR(INITR_BLACKTAB);
  tft.setRotation(0);
  tft.fillScreen(BG_COLOR);

  drawWaitingScreen();

  if (!SerialBT.begin(deviceName)) {
    Serial.println("Bluetooth Start Failed!");
  }
  else {
    Serial.println("Bluetooth Started!");
    Serial.print("Device Name: ");
    Serial.println(deviceName);
  }

  lastClientState = SerialBT.hasClient();
}

void loop() {
  bool connected = SerialBT.hasClient();

  if (connected != lastClientState) {
    lastClientState = connected;

    drawStatus();

    if (connected) {
      Serial.println("Bluetooth Connected");
    }
    else {
      Serial.println("Bluetooth Disconnected");
    }
  }

  while (SerialBT.available()) {
    char c = SerialBT.read();

    if (c == '\n') {
      processGear(inputData);
      inputData = "";
    }
    else if (c != '\r') {
      if (inputData.length() < 20) {
        inputData += c;
      }
      else {
        inputData = "";
      }
    }
  }

  if (
    hasReceivedGear &&
    millis() - lastDataTime >= DATA_TIMEOUT
  ) {
    hasReceivedGear = false;
    currentGear = "WAIT";

    drawWaitingScreen();
  }

  if (!hasReceivedGear) {
    updateWaitingAnimation();
  }
}
